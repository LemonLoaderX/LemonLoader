<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <DefineConstants>ANDROID</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../MelonLoader/InternalUtils/UnityInformationHandler.cs" Link="UnityInformationHandler.cs" />
    <EmbeddedResource Include="../../../MelonLoader/Resources/classdata.tpk" LogicalName="classdata.tpk" />
    <PackageReference Include="AssetsTools.NET" Version="$(AssetToolsVersion)" />
    <PackageReference Include="AssetRipper.Primitives" Version="$(AssetRipperVersion)" />
  </ItemGroup>
</Project>
