<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>JniMigrationProbe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <JavaInteropAssemblyPath Condition="'$(JavaInteropAssemblyPath)' == ''">$([System.IO.Path]::GetDirectoryName('$(MelonLoaderAssemblyPath)'))/Java.Interop.dll</JavaInteropAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Suites.cs;Hardening.cs;DeviceMod.cs" />
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderAssemblyPath)" Private="false" />
    <Reference Include="Java.Interop" HintPath="$(JavaInteropAssemblyPath)" Private="false" />
  </ItemGroup>
</Project>
