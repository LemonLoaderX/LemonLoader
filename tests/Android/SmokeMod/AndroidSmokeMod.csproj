<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>AndroidSmokeMod</AssemblyName>
        <JavaInteropAssemblyPath Condition="'$(JavaInteropAssemblyPath)' == ''">$([System.IO.Path]::GetDirectoryName('$(MelonLoaderAssemblyPath)'))/Java.Interop.dll</JavaInteropAssemblyPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$([System.IO.Path]::GetDirectoryName('$(MelonLoaderAssemblyPath)'))/0Harmony.dll" Private="false" />
        <Reference Include="MonoMod.RuntimeDetour" HintPath="$([System.IO.Path]::GetDirectoryName('$(MelonLoaderAssemblyPath)'))/MonoMod.RuntimeDetour.dll" Private="false" />
        <Reference Include="Java.Interop" HintPath="$(JavaInteropAssemblyPath)" Private="false" />
        <Reference Include="MelonLoader">
            <HintPath>$(MelonLoaderAssemblyPath)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="ValidateMelonLoaderAssembly" BeforeTargets="ResolveReferences">
        <Error Condition="'$(MelonLoaderAssemblyPath)' == '' Or !Exists('$(MelonLoaderAssemblyPath)')"
               Text="Set MelonLoaderAssemblyPath to a built Android MelonLoader.dll." />
    </Target>
</Project>
