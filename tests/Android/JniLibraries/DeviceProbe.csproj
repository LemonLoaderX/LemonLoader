<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>JniLibraryProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DeviceProbe.cs" />
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderAssemblyPath)" Private="false" />
  </ItemGroup>
  <Target Name="CheckInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MelonLoaderAssemblyPath)')" Text="Set MelonLoaderAssemblyPath to an Android Loader assembly." />
  </Target>
</Project>
